{
  "manifest_version": 3,
  "name": "MatchTrak Helper",
  "version": "0.2.2",
  "description": "Adds extra features to the MatchTrak web experience to enable better referee usability.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.matchtrak.com/*/referee.nsf/open-myref-profile/*",
        "https://*.matchtrak.com/*/referee.nsf/open/*"
      ],
      "js": ["dist/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    }
  ]
}
